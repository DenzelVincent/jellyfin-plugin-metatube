<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <TargetFramework>net9.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <!--
          主工程没开可空引用类型标注，测试代码同样不要用 string? 之类的写法，
          否则 CS8632 会把「0 警告」的验收打破。
        -->
        <!--
          本机 WSL 只有 .NET 10 运行时，测试宿主需要按最新主版本回滚才能在 WSL 里跑；
          CI 装了 9.x 运行时时这行不起作用。
        -->
        <RollForward>LatestMajor</RollForward>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1"/>
        <PackageReference Include="xunit" Version="2.9.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Jellyfin.Plugin.MetaTube\Jellyfin.Plugin.MetaTube.csproj"/>
    </ItemGroup>

</Project>
